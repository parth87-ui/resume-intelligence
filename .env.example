# ---------------------------------------------------------------------------
# Resume Intelligence — environment configuration
# Copy to `.env` and edit. Every value below has a working default, so the
# application runs with no .env file at all.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true
# Comma-separated origins, or * for any. Tighten this before deploying.
CORS_ORIGINS=*

# --- Database --------------------------------------------------------------
# SQLite (default, zero setup). The file is created automatically.
# DATABASE_URL=sqlite:///./backend/storage/resume_intelligence.db
#
# PostgreSQL — the same schema runs unchanged:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resume_intelligence

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=10
# Keep the original uploaded file on disk (off by default: only the extracted
# text is stored, which keeps far less personal data at rest).
STORE_UPLOADED_FILES=false
# UPLOAD_DIR=backend/storage/uploads

# --- NLP -------------------------------------------------------------------
ENABLE_SPACY=true
SPACY_MODEL=en_core_web_sm

# --- Generative AI (optional) ---------------------------------------------
# Without a key the AI service uses its deterministic rewrite engine. Both
# paths obey the same honesty rules; the LLM path additionally screens every
# rewrite for numbers that were not in the candidate's original text.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=45
